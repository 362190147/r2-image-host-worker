# 统一用 LF 存进仓库，避免 Windows 上 CRLF 让每次 diff 都"全文件变化"
* text=auto eol=lf

# 二进制文件不要做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

# 生成物在 diff 里折叠（页面模板是构建期生成的，逐字节校验靠 test/page.test.mjs）
src/page.mjs linguist-generated=true
package-lock.json linguist-generated=true
